{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/aby-win/include",
                "${workspaceFolder}/aby-win/include/aby-win",
                "${workspaceFolder}/vendor/glfw/include",
                "${workspaceFolder}/vendor/SDL/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "ABY_RHI_ENABLE_LOG_INFO=1",
                "ABY_RHI_ENABLE_LOG_TRACE=1",
                "ABY_RHI_ENABLE_LOG_WARN=1",
                "ABY_RHI_ENABLE_ASSERT=1"
            ],
            "compilerArgs": [
                "/Zc:preprocessor"
            ],
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "cl.exe",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}